# URL pública do Worker de presença, chat e emissão de sessões de chamada.
VITE_REALTIME_WORKER_URL=https://vybechat-realtime.example.workers.dev

# auto: usa RealtimeKit e só cai para o P2P se o Worker ainda não estiver configurado.
# realtimekit: exige SFU e mostra erro se a configuração estiver ausente.
# legacy: rollback temporário para o motor P2P antigo.
VITE_CALL_ENGINE=auto
